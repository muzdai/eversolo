<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/sw_20dp"
            android:layout_marginRight="@dimen/sw_20dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/sw_20dp">
            <com.zidoo.control.phone.module.music.view.SquareImageView
                android:id="@+id/album_img"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="0x7f08068b"
                android:transitionName="image"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:riv_corner_radius="@dimen/sw_8dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sw_12sp"
                android:textColor="#000000"
                android:id="@+id/tv_subscribe_to_vip"
                android:background="@drawable/bg_kugou_subscribe_to_vip"
                android:paddingLeft="@dimen/sw_10dp"
                android:paddingTop="@dimen/sw_3dp"
                android:paddingRight="@dimen/sw_10dp"
                android:paddingBottom="@dimen/sw_3dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sw_13dp"
                android:text="@string/arm_join_the_premium"
                android:paddingHorizontal="@dimen/sw_10dp"
                android:paddingVertical="@dimen/sw_3dp"
                app:layout_constraintBottom_toBottomOf="@+id/album_img"
                app:layout_constraintEnd_toEndOf="@+id/album_img"
                app:layout_constraintStart_toStartOf="@+id/album_img"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:id="@+id/rl_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/sw_20dp"
                    android:layout_marginRight="@dimen/sw_20dp"
                    android:layout_marginHorizontal="@dimen/sw_20dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.zidoo.control.phone.module.music.view.MarqueeTextView
                                android:textSize="@dimen/sw_18sp"
                                android:textColor="@color/white"
                                android:ellipsize="marquee"
                                android:id="@+id/music_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/no_play_info_tips"
                                android:singleLine="true"
                                android:marqueeRepeatLimit="marquee_forever"/>
                            <TextView
                                android:textSize="@dimen/sw_13sp"
                                android:textColor="@color/white50"
                                android:ellipsize="end"
                                android:id="@+id/artist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sw_3dp"
                                android:maxLines="1"/>
                            <TextView
                                android:textSize="@dimen/sw_13sp"
                                android:textColor="@color/white50"
                                android:ellipsize="end"
                                android:id="@+id/album"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sw_2dp"
                                android:maxLines="1"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_gravity="bottom"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/sw_36dp">
                            <ImageView
                                android:id="@+id/web_music"
                                android:visibility="gone"
                                android:layout_width="@dimen/sw_24dp"
                                android:layout_height="@dimen/sw_24dp"
                                android:src="@drawable/st_more"
                                android:layout_marginStart="@dimen/sw_15dp"/>
                            <ImageView
                                android:id="@+id/like"
                                android:visibility="gone"
                                android:layout_width="@dimen/sw_24dp"
                                android:layout_height="@dimen/sw_24dp"
                                android:src="@drawable/st_like"
                                android:layout_marginStart="@dimen/sw_15dp"/>
                            <ImageView
                                android:id="@+id/dislike"
                                android:visibility="gone"
                                android:layout_width="@dimen/sw_24dp"
                                android:layout_height="@dimen/sw_24dp"
                                android:src="@drawable/st_dislike"
                                android:layout_marginStart="@dimen/sw_15dp"/>
                            <ImageView
                                android:id="@+id/favorite"
                                android:visibility="gone"
                                android:layout_width="@dimen/sw_24dp"
                                android:layout_height="@dimen/sw_24dp"
                                android:src="@drawable/st_favorite"
                                android:layout_marginStart="@dimen/sw_15dp"/>
                            <ImageView
                                android:id="@+id/add_to_song_list"
                                android:visibility="gone"
                                android:layout_width="@dimen/sw_24dp"
                                android:layout_height="@dimen/sw_24dp"
                                android:src="@drawable/st_more"
                                android:layout_marginStart="@dimen/sw_15dp"/>
                            <ImageView
                                android:id="@+id/more"
                                android:visibility="gone"
                                android:layout_width="@dimen/sw_24dp"
                                android:layout_height="@dimen/sw_24dp"
                                android:src="@drawable/st_more"
                                android:layout_marginStart="@dimen/sw_15dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sw_6dp">
                        <ImageView
                            android:gravity="center"
                            android:id="@+id/qualityLabel"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/sw_14dp"
                            android:scaleType="fitStart"
                            android:adjustViewBounds="true"
                            android:layout_marginEnd="@dimen/sw_4dp"/>
                        <LinearLayout
                            android:textSize="@dimen/sw_13sp"
                            android:textColor="#dddddd"
                            android:ellipsize="end"
                            android:orientation="horizontal"
                            android:id="@+id/info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/sw_16dp"
                    android:layout_marginTop="@dimen/sw_18dp"
                    android:layout_marginRight="@dimen/sw_16dp"
                    android:layout_marginHorizontal="@dimen/sw_16dp">
                    <SeekBar
                        android:id="@+id/seek"
                        android:background="@null"
                        android:paddingTop="5.5dp"
                        android:paddingBottom="5.5dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/sw_15dp"
                        android:progressDrawable="@drawable/seekbar_bg"
                        android:thumb="0x7f080089"
                        android:paddingStart="@dimen/sw_6dp"
                        android:paddingEnd="@dimen/sw_6dp"
                        android:splitTrack="false"
                        android:paddingVertical="5.5dp"/>
                    <FrameLayout
                        android:paddingLeft="@dimen/sw_1dp"
                        android:paddingRight="@dimen/sw_1dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sw_3dp"
                        android:paddingHorizontal="@dimen/sw_1dp">
                        <TextView
                            android:textSize="@dimen/sw_9sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/tv_live"
                            android:background="@drawable/bg_rotate_live_text"
                            android:visibility="gone"
                            android:layout_width="@dimen/sw_40dp"
                            android:layout_height="@dimen/sw_17dp"
                            android:text="@string/tunein_live"
                            android:includeFontPadding="false"/>
                        <RelativeLayout
                            android:layout_gravity="center_vertical"
                            android:id="@+id/layout_time"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/sw_11sp"
                                android:textColor="@color/white50"
                                android:gravity="center"
                                android:id="@+id/position"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/music_default_time"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/sw_5dp"/>
                            <TextView
                                android:textSize="@dimen/sw_11sp"
                                android:textColor="@color/white50"
                                android:gravity="center"
                                android:id="@+id/duration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/music_default_time"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="@dimen/sw_6dp"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/info_layout"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/output_decodde"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/sw_13dp"
                                android:adjustViewBounds="true"/>
                            <TextView
                                android:textSize="@dimen/sw_13sp"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:id="@+id/output_info"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:layout_marginStart="@dimen/sw_8dp"
                                android:layout_marginEnd="@dimen/sw_5dp"/>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_85dp"
                    android:layout_marginLeft="@dimen/sw_20dp"
                    android:layout_marginTop="@dimen/sw_10dp"
                    android:layout_marginRight="@dimen/sw_20dp"
                    android:layout_marginHorizontal="@dimen/sw_20dp">
                    <ImageView
                        android:id="@+id/model"
                        android:visibility="visible"
                        android:layout_width="@dimen/sw_25dp"
                        android:layout_height="@dimen/sw_25dp"
                        android:src="@drawable/musicplay_icon_mode"/>
                    <ImageView
                        android:id="@+id/last"
                        android:visibility="visible"
                        android:layout_width="@dimen/sw_44dp"
                        android:layout_height="@dimen/sw_44dp"
                        android:src="@drawable/st_last"
                        android:layout_marginStart="@dimen/sw_37dp"/>
                    <ImageView
                        android:textColor="#aaaaaa"
                        android:id="@+id/play_or_pause"
                        android:visibility="visible"
                        android:layout_width="@dimen/sw_52dp"
                        android:layout_height="@dimen/sw_52dp"
                        android:layout_marginLeft="@dimen/sw_30dp"
                        android:layout_marginRight="@dimen/sw_30dp"
                        android:src="@drawable/st_play"
                        android:layout_marginHorizontal="@dimen/sw_30dp"/>
                    <ImageView
                        android:id="@+id/next"
                        android:visibility="visible"
                        android:layout_width="@dimen/sw_44dp"
                        android:layout_height="@dimen/sw_44dp"
                        android:src="@drawable/st_next"
                        android:layout_marginEnd="@dimen/sw_37dp"/>
                    <ImageView
                        android:id="@+id/queue"
                        android:visibility="visible"
                        android:layout_width="@dimen/sw_25dp"
                        android:layout_height="@dimen/sw_25dp"
                        android:src="@drawable/st_play_queue_detail"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/volume_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sw_40dp"
                    android:layout_marginLeft="@dimen/sw_20dp"
                    android:layout_marginRight="@dimen/sw_20dp"
                    android:layout_marginHorizontal="@dimen/sw_20dp">
                    <ImageView
                        android:id="@+id/volume_icon"
                        android:layout_width="@dimen/sw_14dp"
                        android:layout_height="@dimen/sw_12dp"
                        android:src="@drawable/musicplay_volume_on"
                        android:layout_marginEnd="@dimen/sw_5dp"/>
                    <SeekBar
                        android:id="@+id/volume_seek"
                        android:background="@null"
                        android:paddingTop="5.5dp"
                        android:paddingBottom="5.5dp"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/sw_15dp"
                        android:progressDrawable="@drawable/seekbar_bg"
                        android:thumb="@drawable/bg_volume_bt"
                        android:layout_weight="1"
                        android:paddingStart="@dimen/sw_4dp"
                        android:paddingEnd="@dimen/sw_4dp"
                        android:splitTrack="false"
                        android:paddingVertical="5.5dp"/>
                    <TextView
                        android:textSize="@dimen/sw_11sp"
                        android:textColor="@color/white50"
                        android:id="@+id/tv_volum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="22dp"/>
                    <ImageView
                        android:id="@+id/volume_down"
                        android:layout_width="@dimen/sw_22dp"
                        android:layout_height="@dimen/sw_22dp"
                        android:src="@drawable/st_sound_down"
                        android:layout_marginStart="@dimen/sw_7dp"/>
                    <ImageView
                        android:id="@+id/volume_up"
                        android:layout_width="@dimen/sw_22dp"
                        android:layout_height="@dimen/sw_22dp"
                        android:src="@drawable/st_sound_up"
                        android:layout_marginStart="@dimen/sw_15dp"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/pb_load"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/main_color"
        style="@style/Base.Widget.AppCompat.ProgressBar"/>
    <TextView
        android:textSize="@dimen/sw_11sp"
        android:textStyle="bold"
        android:textColor="@color/white50"
        android:id="@+id/gain_info"
        android:background="@drawable/shape_audio_output"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sw_110dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:layout_marginStart="@dimen/sw_5dp"/>
</RelativeLayout>
