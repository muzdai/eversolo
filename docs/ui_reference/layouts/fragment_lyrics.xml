<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/sw_20dp"
        android:layout_marginRight="@dimen/sw_20dp"
        android:layout_marginHorizontal="@dimen/sw_20dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/icon"
                    android:layout_width="@dimen/sw_60dp"
                    android:layout_height="@dimen/sw_60dp"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="@dimen/sw_10dp"
                    app:riv_corner_radius="@dimen/sw_4dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.zidoo.control.phone.module.music.view.MarqueeTextView
                        android:textSize="@dimen/sw_18sp"
                        android:textColor="@color/white"
                        android:ellipsize="marquee"
                        android:id="@+id/music_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_play_info_tips"
                        android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever"/>
                    <TextView
                        android:textSize="@dimen/sw_13sp"
                        android:textColor="@color/white50"
                        android:ellipsize="end"
                        android:id="@+id/artist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sw_2dp"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="@dimen/sw_13sp"
                        android:textColor="@color/white50"
                        android:ellipsize="end"
                        android:id="@+id/album"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sw_11sp"
                android:textColor="#ffc48b"
                android:id="@+id/tv_subscribe_to_vip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arm_join_the_premium_v1"
                android:layout_marginStart="@dimen/sw_70dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sw_5dp">
            <ImageView
                android:id="@+id/web_music"
                android:visibility="gone"
                android:layout_width="@dimen/sw_24dp"
                android:layout_height="@dimen/sw_24dp"
                android:src="@drawable/st_more"
                android:layout_marginStart="@dimen/sw_15dp"/>
            <ImageView
                android:id="@+id/like"
                android:visibility="gone"
                android:layout_width="@dimen/sw_24dp"
                android:layout_height="@dimen/sw_24dp"
                android:src="@drawable/st_like"
                android:layout_marginStart="@dimen/sw_15dp"/>
            <ImageView
                android:id="@+id/dislike"
                android:visibility="gone"
                android:layout_width="@dimen/sw_24dp"
                android:layout_height="@dimen/sw_24dp"
                android:src="@drawable/st_dislike"
                android:layout_marginStart="@dimen/sw_15dp"/>
            <ImageView
                android:id="@+id/favorite"
                android:visibility="gone"
                android:layout_width="@dimen/sw_24dp"
                android:layout_height="@dimen/sw_24dp"
                android:src="@drawable/st_favorite"
                android:layout_marginStart="@dimen/sw_15dp"/>
            <ImageView
                android:id="@+id/add_to_song_list"
                android:visibility="gone"
                android:layout_width="@dimen/sw_24dp"
                android:layout_height="@dimen/sw_24dp"
                android:src="@drawable/st_more"
                android:layout_marginStart="@dimen/sw_15dp"/>
            <ImageView
                android:id="@+id/more"
                android:visibility="gone"
                android:layout_width="@dimen/sw_24dp"
                android:layout_height="@dimen/sw_24dp"
                android:src="@drawable/st_more"
                android:layout_marginStart="@dimen/sw_15dp"/>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/pb_load"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/main_color"
        style="@style/Base.Widget.AppCompat.ProgressBar"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/content">
        <com.zidoo.control.phone.module.music.view.MyManyLrcView
            android:id="@+id/lyrics_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-8dp"
            android:paddingStart="@dimen/sw_20dp"/>
        <TextView
            android:textSize="@dimen/sw_17sp"
            android:textColor="@color/white80"
            android:layout_gravity="center"
            android:id="@+id/tv_no_lyric"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_lyric"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/content_player"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="@dimen/sw_20dp"
            android:layout_marginRight="@dimen/sw_20dp"
            android:layout_marginHorizontal="@dimen/sw_20dp">
            <LinearLayout
                android:gravity="end"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/model"
                    android:visibility="gone"
                    android:layout_width="@dimen/sw_25dp"
                    android:layout_height="@dimen/sw_25dp"
                    android:src="@drawable/musicplay_icon_mode"/>
                <ImageView
                    android:id="@+id/last"
                    android:visibility="gone"
                    android:layout_width="@dimen/sw_44dp"
                    android:layout_height="@dimen/sw_44dp"
                    android:src="@drawable/st_last"
                    android:layout_marginStart="@dimen/sw_37dp"/>
                <ImageView
                    android:id="@+id/play_or_pause"
                    android:visibility="visible"
                    android:layout_width="@dimen/sw_32dp"
                    android:layout_height="@dimen/sw_32dp"
                    android:layout_marginLeft="@dimen/sw_17dp"
                    android:layout_marginRight="@dimen/sw_17dp"
                    android:src="0x7f08081f"
                    android:layout_marginHorizontal="@dimen/sw_17dp"/>
                <ImageView
                    android:id="@+id/next"
                    android:visibility="visible"
                    android:layout_width="@dimen/sw_32dp"
                    android:layout_height="@dimen/sw_32dp"
                    android:src="0x7f08081d"/>
                <ImageView
                    android:id="@+id/queue"
                    android:visibility="gone"
                    android:layout_width="@dimen/sw_25dp"
                    android:layout_height="@dimen/sw_25dp"
                    android:src="@drawable/st_play_queue_detail"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/volume_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sw_40dp">
                <ImageView
                    android:id="@+id/volume_icon"
                    android:layout_width="@dimen/sw_14dp"
                    android:layout_height="@dimen/sw_12dp"
                    android:src="@drawable/musicplay_volume_on"
                    android:layout_marginEnd="@dimen/sw_5dp"/>
                <SeekBar
                    android:id="@+id/volume_seek"
                    android:background="@null"
                    android:paddingTop="5.5dp"
                    android:paddingBottom="5.5dp"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/sw_15dp"
                    android:progressDrawable="@drawable/seekbar_bg"
                    android:thumb="@drawable/bg_volume_bt"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/sw_4dp"
                    android:paddingEnd="@dimen/sw_4dp"
                    android:splitTrack="false"
                    android:paddingVertical="5.5dp"/>
                <TextView
                    android:textSize="@dimen/sw_11sp"
                    android:textColor="@color/white50"
                    android:id="@+id/tv_volum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="22dp"/>
                <ImageView
                    android:id="@+id/volume_down"
                    android:layout_width="@dimen/sw_22dp"
                    android:layout_height="@dimen/sw_22dp"
                    android:src="@drawable/st_sound_down"
                    android:layout_marginStart="@dimen/sw_7dp"/>
                <ImageView
                    android:id="@+id/volume_up"
                    android:layout_width="@dimen/sw_22dp"
                    android:layout_height="@dimen/sw_22dp"
                    android:src="@drawable/st_sound_up"
                    android:layout_marginStart="@dimen/sw_15dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>
