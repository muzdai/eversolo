<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/transparent"
    android:paddingTop="@dimen/sw_8dp"
    android:paddingBottom="@dimen/sw_8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:transitionName="playback"
    android:paddingVertical="@dimen/sw_8dp">
    <RelativeLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sw_60dp"
            android:src="@drawable/shape_playback_bar"
            android:scaleType="centerCrop"
            android:paddingStart="@dimen/sw_1dp"
            android:paddingEnd="@dimen/sw_1dp"/>
        <com.makeramen.roundedimageview.RoundedImageView
            android:background="@drawable/shape_shadow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sw_60dp"
            android:scaleType="centerCrop"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/icon_layout"
        android:layout_width="@dimen/sw_50dp"
        android:layout_height="@dimen/sw_50dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/sw_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/music_control_album"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f0806a5"
            app:riv_border_color="@color/white"
            app:riv_border_width="1dp"
            app:riv_oval="true"/>
        <ImageView
            android:id="@+id/cd_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f080ce4"
            app:layout_constraintEnd_toEndOf="@+id/music_control_album"
            app:layout_constraintStart_toStartOf="@+id/music_control_album"/>
        <com.zidoo.control.phone.module.apps.view.CircleProgressView
            android:id="@+id/progress"
            android:layout_width="@dimen/sw_50dp"
            android:layout_height="@dimen/sw_50dp"
            app:cr_behindColor="#aaffffff"
            app:cr_progressColor="#FF8247,#FF7256,#CDAD00,#FF7256,#FF8247"
            app:cr_progressWidthRatio="0.02"
            app:cr_rotateAngle="-90"
            app:cr_widthRatio="0.02"
            app:layout_constraintBottom_toBottomOf="@+id/cd_view"
            app:layout_constraintEnd_toEndOf="@+id/cd_view"
            app:layout_constraintStart_toStartOf="@+id/cd_view"
            app:layout_constraintTop_toTopOf="@+id/cd_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="11dp"
        android:layout_marginRight="11dp"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon_layout"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/item_title_color"
            android:ellipsize="end"
            android:gravity="bottom"
            android:id="@+id/title"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="@string/music_name"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <TextView
            android:textSize="9sp"
            android:textColor="#bfbfbf"
            android:ellipsize="end"
            android:gravity="top"
            android:id="@+id/artist"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sw_2dp"
            android:lines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/control_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ll_volume"
        app:layout_constraintStart_toEndOf="@+id/ll_title"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/model"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/musicplay_icon_mode"
            android:layout_marginEnd="@dimen/sw_10dp"/>
        <ImageView
            android:id="@+id/last"
            android:layout_width="@dimen/sw_60dp"
            android:layout_height="@dimen/sw_60dp"
            android:src="@drawable/st_last"
            android:scaleType="centerInside"
            android:layout_marginEnd="@dimen/sw_2dp"/>
        <ImageView
            android:id="@+id/play_or_pause"
            android:layout_width="@dimen/sw_25dp"
            android:layout_height="@dimen/sw_25dp"
            android:src="@drawable/st_play_small"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/sw_2dp"
            android:layout_marginEnd="@dimen/sw_2dp"/>
        <ImageView
            android:id="@+id/next"
            android:layout_width="@dimen/sw_60dp"
            android:layout_height="@dimen/sw_60dp"
            android:src="@drawable/st_next"
            android:scaleType="centerInside"
            android:layout_marginEnd="@dimen/sw_3dp"/>
        <ImageView
            android:id="@+id/play_queue"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/st_play_queue"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/sw_5dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/round_play_queue"
        android:background="@drawable/playbar_icon_queue2"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/sw_5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/control_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.zidoo.control.phone.module.music.view.DispatchView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_volume"
        app:layout_constraintEnd_toEndOf="@+id/ll_volume"
        app:layout_constraintStart_toStartOf="@+id/ll_volume"
        app:layout_constraintTop_toTopOf="@+id/ll_volume"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_volume"
        android:paddingLeft="@dimen/sw_15dp"
        android:paddingRight="@dimen/sw_15dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/sw_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_music_seekbar"
            android:paddingLeft="@dimen/sw_5dp"
            android:paddingRight="@dimen/sw_5dp"
            android:layout_width="@dimen/sw_220dp"
            android:layout_height="@dimen/sw_30dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/sw_5dp">
            <ImageView
                android:id="@+id/volume_icon"
                android:layout_width="@dimen/sw_23dp"
                android:layout_height="@dimen/sw_23dp"
                android:src="0x7f08008c"
                android:scaleType="centerInside"/>
            <SeekBar
                android:id="@+id/volume_seek"
                android:background="@null"
                android:paddingTop="@dimen/sw_9dp"
                android:paddingBottom="@dimen/sw_9dp"
                android:layout_width="0dp"
                android:layout_height="@dimen/sw_20dp"
                android:maxWidth="@dimen/sw_200dp"
                android:progressDrawable="@drawable/seekbar_bg_land"
                android:thumb="@drawable/bg_volume_bt_min"
                android:layout_weight="1"
                android:splitTrack="false"
                android:paddingVertical="@dimen/sw_9dp"/>
            <TextView
                android:textSize="@dimen/sw_10sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_volum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="15dp"
                android:paddingEnd="5dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/volume_down"
            android:layout_width="@dimen/sw_23dp"
            android:layout_height="@dimen/sw_23dp"
            android:src="@drawable/st_sound_down"
            android:layout_marginStart="@dimen/sw_10dp"/>
        <ImageView
            android:id="@+id/volume_up"
            android:layout_width="@dimen/sw_23dp"
            android:layout_height="@dimen/sw_23dp"
            android:src="@drawable/st_sound_up"
            android:layout_marginStart="@dimen/sw_5dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
