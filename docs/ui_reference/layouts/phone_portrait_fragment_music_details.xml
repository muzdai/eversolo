<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/artist_image_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/album_bg"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/album_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <ImageView
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.4"/>
        <ImageView
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/fl_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/move_point"
            android:layout_below="@+id/title_layout">
            <com.zidoo.control.phone.module.music.view.CustomViewPager
                android:id="@+id/detailed_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/other_play_type_layout"
            android:background="0x7f080062"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/info_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sw_50dp"
                android:layout_marginTop="@dimen/sw_15dp"
                android:layout_marginBottom="@dimen/sw_15dp"
                android:layout_below="@+id/play_type">
                <ImageView
                    android:id="@+id/output_decodde"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"/>
                <TextView
                    android:textSize="@dimen/sw_20sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/output_info"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="48kHz"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/sw_15dp"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/sw_15sp"
                android:textColor="@color/item_title_color"
                android:id="@+id/play_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <com.zidoo.control.phone.module.music.view.MovePoint
            android:id="@+id/move_point"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sw_35dp"
            android:layout_alignParentBottom="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sw_50dp">
            <ImageView
                android:id="@+id/close"
                android:layout_width="@dimen/sw_24dp"
                android:layout_height="@dimen/sw_24dp"
                android:src="@drawable/st_down_close"
                android:layout_marginStart="@dimen/sw_20dp"/>
            <ImageView
                android:id="@+id/source_from"
                android:layout_width="0dp"
                android:layout_height="@dimen/sw_45dp"
                android:scaleType="fitStart"
                android:layout_weight="1"
                android:layout_marginStart="10dp"/>
            <ImageView
                android:id="@+id/source_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/sw_30dp"
                android:scaleType="fitStart"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="@dimen/sw_14sp"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/source_title"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="@dimen/sw_50dp"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_marginStart="10dp"/>
            <LinearLayout
                android:id="@+id/ll_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/sw_5dp">
                <ImageView
                    android:id="@+id/stream_change"
                    android:visibility="gone"
                    android:layout_width="@dimen/sw_24dp"
                    android:layout_height="@dimen/sw_24dp"
                    android:src="@drawable/st_stream_change"
                    android:layout_marginEnd="@dimen/sw_15dp"/>
                <ImageView
                    android:id="@+id/channel_change"
                    android:visibility="gone"
                    android:layout_width="@dimen/sw_24dp"
                    android:layout_height="@dimen/sw_24dp"
                    android:src="@drawable/st_stream_change"
                    android:layout_marginEnd="@dimen/sw_15dp"/>
                <ImageView
                    android:id="@+id/sub"
                    android:visibility="gone"
                    android:layout_width="@dimen/sw_24dp"
                    android:layout_height="@dimen/sw_24dp"
                    android:src="@drawable/musicplay_icon_sub_off"
                    android:layout_marginEnd="@dimen/sw_15dp"/>
                <ImageView
                    android:id="@+id/eq"
                    android:visibility="gone"
                    android:layout_width="@dimen/sw_24dp"
                    android:layout_height="@dimen/sw_24dp"
                    android:src="@drawable/st_detail_eq"
                    android:layout_marginEnd="@dimen/sw_15dp"/>
                <ImageView
                    android:id="@+id/dsp"
                    android:visibility="gone"
                    android:layout_width="@dimen/sw_24dp"
                    android:layout_height="@dimen/sw_24dp"
                    android:src="@drawable/st_detail_dsp"
                    android:layout_marginEnd="@dimen/sw_15dp"/>
                <ImageView
                    android:id="@+id/sp_change"
                    android:visibility="visible"
                    android:layout_width="@dimen/sw_24dp"
                    android:layout_height="@dimen/sw_24dp"
                    android:src="@drawable/musicplay_icon_pinpu"
                    android:layout_marginEnd="@dimen/sw_15dp"/>
                <ImageView
                    android:id="@+id/vu_change"
                    android:visibility="visible"
                    android:layout_width="@dimen/sw_24dp"
                    android:layout_height="@dimen/sw_24dp"
                    android:src="@drawable/musicplay_icon_vu"
                    android:layout_marginEnd="@dimen/sw_15dp"/>
                <ImageView
                    android:textSize="@dimen/sw_20sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_55EBE9E9"
                    android:gravity="center"
                    android:id="@+id/rematch_lrc"
                    android:visibility="gone"
                    android:layout_width="@dimen/sw_24dp"
                    android:layout_height="@dimen/sw_24dp"
                    android:text="@string/lrc"
                    android:layout_marginEnd="@dimen/sw_15dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/source_from_layout"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/sw_35dp"
            android:layout_marginTop="@dimen/sw_12dp"
            android:layout_marginBottom="@dimen/sw_15dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/sw_19dp">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/content_device_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/sw_10dp">
                <TextView
                    android:textSize="@dimen/sw_11sp"
                    android:textColor="@color/white60"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_deviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/view_round"
                    android:background="@drawable/shape_round_bg"
                    android:visibility="visible"
                    android:layout_width="@dimen/sw_4dp"
                    android:layout_height="@dimen/sw_4dp"
                    android:layout_marginStart="@dimen/sw_10dp"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/source_from_in"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/sw_15dp"
                android:src="0x7f080562"
                android:scaleType="centerInside"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/source_from_arrow"
                android:visibility="gone"
                android:layout_width="@dimen/sw_9dp"
                android:layout_height="@dimen/sw_6dp"
                android:layout_marginLeft="@dimen/sw_5dp"
                android:layout_marginRight="@dimen/sw_5dp"
                android:src="0x7f08007f"
                android:scaleType="centerInside"
                android:layout_marginHorizontal="@dimen/sw_5dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/source_from_out"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:scaleType="fitStart"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
